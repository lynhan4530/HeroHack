<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsOpen">
      <Children>

        <!-- Dark backdrop -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55" />

        <!-- Main panel -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="900" SuggestedHeight="840"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#111827FF" AlphaFactor="0.98">
          <Children>

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <!-- Header 45px -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="45"
                        Sprite="BlankWhiteSquare_9" Color="#1E3A5FFF" AlphaFactor="1">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="HeroHack v1.0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="15" />
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="36" SuggestedHeight="36"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  MarginRight="7"
                                  Command.Click="ExecuteClose"
                                  DoNotPassEventsToChildren="true"
                                  Brush="ButtonBrush2">
                      <Children>
                        <TextWidget Text="X"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>

                <!-- Tab bar 40px -->
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           Sprite="BlankWhiteSquare_9" Color="#0F172AFF" AlphaFactor="1">
                  <Children>
                    <ButtonWidget Text="Hero"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="200" SuggestedHeight="36"
                                  VerticalAlignment="Center" MarginLeft="5" MarginTop="2"
                                  Command.Click="ExecuteSelectTab0"
                                  IsSelected="@IsTab0Active"
                                  ButtonType="Toggle"
                                  Brush="ButtonBrush2" />
                    <ButtonWidget Text="Party"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="200" SuggestedHeight="36"
                                  VerticalAlignment="Center" MarginLeft="4" MarginTop="2"
                                  Command.Click="ExecuteSelectTab1"
                                  IsSelected="@IsTab1Active"
                                  ButtonType="Toggle"
                                  Brush="ButtonBrush2" />
                    <ButtonWidget Text="Settlement"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="200" SuggestedHeight="36"
                                  VerticalAlignment="Center" MarginLeft="4" MarginTop="2"
                                  Command.Click="ExecuteSelectTab2"
                                  IsSelected="@IsTab2Active"
                                  ButtonType="Toggle"
                                  Brush="ButtonBrush2" />
                    <ButtonWidget Text="Export / Import"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="200" SuggestedHeight="36"
                                  VerticalAlignment="Center" MarginLeft="4" MarginTop="2"
                                  Command.Click="ExecuteSelectTab3"
                                  IsSelected="@IsTab3Active"
                                  ButtonType="Toggle"
                                  Brush="ButtonBrush2" />
                  </Children>
                </ListPanel>

                <!-- Content area 720px -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="720">
                  <Children>

                    <!-- STEP 1: Hero tab - minimal, only TextWidgets, sub-VM DataSource active -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsTab0Active" DataSource="{HeroTab}">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   StackLayout.LayoutMethod="VerticalTopToBottom"
                                   MarginLeft="12" MarginRight="12" MarginTop="8">
                          <Children>
                            <TextWidget Text="[DEBUG STEP 1] Sub-VM binding active"
                                        WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        MarginBottom="6" />
                            <TextWidget Text="@SelectedHeroName"
                                        WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        MarginBottom="6" />
                            <TextWidget Text="Gold:"
                                        WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" />
                            <TextWidget Text="@GoldText"
                                        WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" />
                            <ButtonWidget Text="Apply Gold (test)"
                                          WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                          SuggestedWidth="160" SuggestedHeight="28"
                                          Brush="ButtonBrush2"
                                          Command.Click="ExecuteApplyGold"
                                          DoNotPassEventsToChildren="true" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>

                    <!-- Party tab placeholder -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsTab1Active">
                      <Children>
                        <TextWidget Text="Party Tab - Phase 4"
                                    WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                    <!-- Settlement tab placeholder -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsTab2Active">
                      <Children>
                        <TextWidget Text="Settlement Tab - Phase 4"
                                    WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                    <!-- IO tab placeholder -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsTab3Active">
                      <Children>
                        <TextWidget Text="Export / Import Tab - Phase 5"
                                    WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </Widget>

                  </Children>
                </Widget>

                <!-- Status bar 35px -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="35"
                        Sprite="BlankWhiteSquare_9" Color="#0F172AFF" AlphaFactor="1">
                  <Children>
                    <TextWidget Text="@StatusMessage"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="10" />
                  </Children>
                </Widget>

              </Children>
            </ListPanel>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
