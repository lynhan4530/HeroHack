<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsOpen">
      <Children>

        <!-- Full-screen opaque backdrop — kills PAUSED/map bleed-through -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.82" />

        <!-- Main panel: 920 x 1010, fully opaque, centred -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="920" SuggestedHeight="1010"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#0D1117FF" AlphaFactor="1.0">
          <Children>

            <!-- Floating X close button (above everything) -->
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="34" SuggestedHeight="30"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          MarginRight="6" MarginTop="6"
                          Command.Click="ExecuteClose"
                          DoNotPassEventsToChildren="true" Brush="ButtonBrush2">
              <Children>
                <TextWidget Text="X" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
              </Children>
            </ButtonWidget>

            <!--
              =============================================================
              OUTER STACK — all children Fixed height → guaranteed top-down
              order. Content is FIRST child = TOP. Tabs are LAST = BOTTOM.
              927 + 28 + 55 = 1010 px (exact panel height).
              =============================================================
            -->
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       StackLayout.LayoutMethod="VerticalBottomToTop">
              <Children>

                <!-- ══════════════════════════════════════════════════════
                     CONTENT  Fixed 747 px  — FIRST = TOP
                ══════════════════════════════════════════════════════ -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="927">
                  <Children>

                    <!-- TAB 0 : Hero -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsTab0Active">
                      <Children>
                        <!--
                          CoverChildren + VerticalAlignment="Top" — proven Phase 1 pattern.
                          DataSource on this ListPanel; all bindings resolve in HeroTabVM.
                          Usable width: 920 − 30 − 30 = 860 px.
                          Column math (3-col): 88 + 188 + 16 gap = 292 × 3 − 16 = 860 px ✓
                          Column math (2-col): 100 + 226 + 8 + 72 = 406 × 2 + 12 = 824 px ✓
                        -->
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   VerticalAlignment="Top"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   DataSource="{HeroTab}"
                                   MarginLeft="30" MarginRight="30" MarginTop="10">
                          <Children>

                            <!-- ─── IDENTITY ─────────────────────────── -->

                            <TextWidget Text="@SelectedHeroName"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32"
                                        HorizontalAlignment="Center" Color="#CFB53BFF" FontSize="24" />

                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                       StackLayout.LayoutMethod="HorizontalLeftToRight"
                                       HorizontalAlignment="Center"
                                       MarginTop="4" MarginBottom="10">
                              <Children>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="26" SuggestedHeight="24"
                                              Command.Click="ExecutePrevHero"
                                              DoNotPassEventsToChildren="true" Brush="ButtonBrush2">
                                  <Children>
                                    <TextWidget Text="&lt;" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                                  </Children>
                                </ButtonWidget>
                                <TextWidget Text="@HeroCountText"
                                            WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="52"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MarginLeft="15" MarginRight="15" FontSize="14" />
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="26" SuggestedHeight="24"
                                              MarginLeft="10"
                                              Command.Click="ExecuteNextHero"
                                              DoNotPassEventsToChildren="true" Brush="ButtonBrush2">
                                  <Children>
                                    <TextWidget Text="&gt;" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="64" SuggestedHeight="24" MarginLeft="30"
                                              Command.Click="ExecuteRefreshHeroes"
                                              DoNotPassEventsToChildren="true" Brush="ButtonBrush2">
                                  <Children>
                                    <TextWidget Text="Refresh" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </ListPanel>

                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1"
                                    Sprite="BlankWhiteSquare_9" Color="#55627EFF" MarginBottom="8" />

