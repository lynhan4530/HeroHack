                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="28" VerticalAlignment="Center" MarginLeft="40" Command.Click="ExecuteApplyGold" DoNotPassEventsToChildren="true" Brush="ButtonBrush2">
